# Server-side only. NEVER put these in the mobile app — anything in the app
# bundle is readable by anyone who downloads it.

ANTHROPIC_API_KEY=sk-ant-...

# Flutterwave (covers MTN MoMo, Airtel Money and cards in Uganda)
FLUTTERWAVE_SECRET_KEY=FLWSECK-...
# The value you set as "Secret hash" in the Flutterwave dashboard webhook
# settings. Requests whose verif-hash header does not match are rejected.
FLUTTERWAVE_WEBHOOK_SECRET=change-me

# Public base URL of this service, used to build the payment redirect URL.
PUBLIC_BASE_URL=https://triorgan-backend.onrender.com

# Optional: override the model.
HELIK_MODEL=claude-opus-5
